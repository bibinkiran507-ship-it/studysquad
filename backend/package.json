{
  "name": "studysquad-backend",
  "version": "1.0.0",
  "description": "StudySquad Backend API with Express, Prisma, Socket.io, and Gemini AI",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prepare:db": "node scripts/prepare-db.js",
    "prisma:generate": "node scripts/prepare-db.js && prisma generate",
    "prisma:push": "node scripts/prepare-db.js && prisma db push --accept-data-loss",
    "prisma:seed": "node prisma/seed.js",
    "build": "npm run prisma:generate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.1",
    "prisma": "^6.4.1"
  },
  "devDependencies": {}
}
