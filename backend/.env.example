# Database Configuration
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Supabase, Neon, Railway, Render Postgres):
# 1. In prisma/schema.prisma, change: provider = "postgresql"
# 2. Set your connection string below:
# DATABASE_URL="postgresql://username:password@ep-example.pooler.region.supabase.co:6543/postgres?pgbouncer=true"

# JWT Secret for Session Tokens (use a strong random string in production)
JWT_SECRET="studysquad-super-secret-jwt-key-2026"

# Port (Cloud providers like Render/Railway automatically assign PORT)
PORT=3001

# Allowed Frontend Origins for CORS (comma-separated, or * for all)
# Example: CLIENT_URL="https://my-studysquad.vercel.app,http://localhost:5173"
CLIENT_URL="*"

# Google OAuth Client ID (optional, matches frontend)
GOOGLE_CLIENT_ID="235319617346-rh4dohmi84qnl1cabt0tqp39c3usdpr3.apps.googleusercontent.com"

# Google Gemini API Key for AI Goal Suggestions and Matchmaker (optional)
GEMINI_API_KEY=""

# Node Environment ('development' or 'production')
NODE_ENV="development"

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
